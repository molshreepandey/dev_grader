# Copy to .env — docker compose reads it automatically.

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=grader-workers
SUBMISSION_TOPIC=grader-submission
RESULT_TOPIC=grader-result

# How many students grade in parallel. Budget concurrency * GRADER_CPU_LIMIT
# cores and concurrency * GRADER_MEMORY_MB of RAM on the host.
GRADER_CONCURRENCY=2

# Per-task resource ceiling, enforced with cgroup v2.
GRADER_MEMORY_MB=2048
GRADER_CPU_LIMIT=2
GRADER_PIDS_MAX=512

# Per-stage wall-clock limits, in seconds.
GRADER_CLONE_TIMEOUT_SECS=120
GRADER_INSTALL_TIMEOUT_SECS=600
GRADER_TEST_TIMEOUT_SECS=600

# Largest combined checkout (student + hidden tests) we will grade, in MB.
GRADER_MAX_REPO_MB=512

# Ceiling for the whole container, on top of the per-task cgroups.
GRADER_HOST_CPUS=6
GRADER_HOST_MEMORY=6g

RUST_LOG=info

# --- local development only -------------------------------------------------
# Namespaces + cgroups need root and a cgroup v2 tree. Set this to false to run
# the pipeline on a dev box without them — student code then runs with your own
# privileges, so never do this on a shared or production machine.
# GRADER_ISOLATION=false
# GRADER_WORK_DIR=/tmp/grader/work
# GRADER_CACHE_DIR=/tmp/grader/cache
