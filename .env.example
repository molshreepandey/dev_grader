# Copy to `.env` (docker compose reads it automatically) and adjust.

# Kafka. On the server, point this at the broker the Java services already use.
# With `docker compose --profile local up`, leave it as kafka:9092.
KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=grader-workers
SUBMISSION_TOPIC=assignment-submission
RESULT_TOPIC=assignment-result

# Submissions graded in parallel. Each one may spawn a full build toolchain (2 GiB / 2 cores at
# the sandbox limits), so size this against the host, not against the queue.
GRADER_CONCURRENCY=4

RUST_LOG=info

# The image to run. Override to test a locally built image: GRADER_IMAGE=lamicons-dev-engine:dev
GRADER_IMAGE=ghcr.io/lamicons-enterprise/lamicons-dev-engine:prod

# Only read by the binaries directly (the image sets them; compose does not override them):
#   ASSIGNMENTS_ROOT=/opt/assignments
#   ROOTFS_BASE=/opt/sandbox_rootfs
#   WORK_ROOT=/tmp/grader
