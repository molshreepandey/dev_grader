{
  "stack": "python",
  "merge": {
    "mode": "solution_files",
    "files": ["src/solution.py"]
  },
  "install": [
    "/bin/sh",
    "-c",
    "python3 -m venv .venv && .venv/bin/pip install --no-input -r requirements.txt"
  ],
  "test": [".venv/bin/pytest", "--junitxml=report.xml", "-q"],
  "report": { "file": "report.xml" }
}
